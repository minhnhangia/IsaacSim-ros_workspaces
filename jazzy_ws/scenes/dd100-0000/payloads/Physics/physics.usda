#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tn__dd1000000_qD"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "tn__dd1000000_qD"
{
    over "Geometry"
    {
        over "base_link"
        {
            over "chassis_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.2216, 0.2458, 0.4474, 0, 0, 0]
                bool newton:selfCollisionEnabled = 0
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.2216, 0.2458, 0.4474)
                float physics:mass = 10
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "front_left_wheel_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                )
                {
                    double[] newton:inertia = [0.0003234, 0.0003234, 0.00049015, 0, 0, 0]
                    point3f physics:centerOfMass = (0, 0, 0)
                    float3 physics:diagonalInertia = (0.0003234, 0.0003234, 0.00049015)
                    float physics:mass = 0.111
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "cylinder" (
                        prepend apiSchemas = ["NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "front_right_wheel_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                )
                {
                    double[] newton:inertia = [0.0003234, 0.0003234, 0.00049015, 0, 0, 0]
                    point3f physics:centerOfMass = (0, 0, 0)
                    float3 physics:diagonalInertia = (0.0003234, 0.0003234, 0.00049015)
                    float physics:mass = 0.111
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "cylinder" (
                        prepend apiSchemas = ["NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "rear_caster" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                )
                {
                    double[] newton:inertia = [0.001, 0.001, 0.001, 0, 0, 0]
                    point3f physics:centerOfMass = (0, 0, 0)
                    float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
                    float physics:mass = 0.1
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "sphere_1" (
                        prepend apiSchemas = ["NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "imu_0_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                )
                {
                    double[] newton:inertia = [1e-9, 1e-9, 1e-9, 0, 0, 0]
                    point3f physics:centerOfMass = (0, 0, 0)
                    float3 physics:diagonalInertia = (1e-9, 1e-9, 1e-9)
                    float physics:mass = 0.001
                    quatf physics:principalAxes = (1, 0, 0, 0)
                }
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "front_left_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </tn__dd1000000_qD/Geometry/base_link/chassis_link>
            custom rel physics:body1
            append rel physics:body1 = </tn__dd1000000_qD/Geometry/base_link/chassis_link/front_left_wheel_link>
            point3f physics:localPos0 = (0.0989838, 0.2261616, 0.0345)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "front_right_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </tn__dd1000000_qD/Geometry/base_link/chassis_link>
            custom rel physics:body1
            append rel physics:body1 = </tn__dd1000000_qD/Geometry/base_link/chassis_link/front_right_wheel_link>
            point3f physics:localPos0 = (0.0989838, -0.2261616, 0.0345)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "base_link_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </tn__dd1000000_qD>
            custom rel physics:body1
            append rel physics:body1 = </tn__dd1000000_qD/Geometry/base_link/chassis_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "rear_caster_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </tn__dd1000000_qD/Geometry/base_link/chassis_link>
            custom rel physics:body1
            append rel physics:body1 = </tn__dd1000000_qD/Geometry/base_link/chassis_link/rear_caster>
            point3f physics:localPos0 = (-0.244, 0, -0.00674)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "imu_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </tn__dd1000000_qD/Geometry/base_link/chassis_link>
            custom rel physics:body1
            append rel physics:body1 = </tn__dd1000000_qD/Geometry/base_link/chassis_link/imu_0_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

