            prepend color3f inputs:diffuseColor.connect = </Materials/Material_001.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/Material_001.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/Material_001.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/Material_001.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

