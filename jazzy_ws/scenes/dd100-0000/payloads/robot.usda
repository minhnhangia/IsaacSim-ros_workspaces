#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tn__dd1000000_qD"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "tn__dd1000000_qD" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </tn__dd1000000_qD/Physics/base_link_joint>,
        </tn__dd1000000_qD/Physics/front_left_wheel_joint>,
        </tn__dd1000000_qD/Physics/front_right_wheel_joint>,
        </tn__dd1000000_qD/Physics/rear_caster_joint>,
        </tn__dd1000000_qD/Physics/imu_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </tn__dd1000000_qD/Geometry/base_link/chassis_link>,
        </tn__dd1000000_qD/Geometry/base_link/chassis_link/front_left_wheel_link>,
        </tn__dd1000000_qD/Geometry/base_link/chassis_link/front_right_wheel_link>,
        </tn__dd1000000_qD/Geometry/base_link/chassis_link/rear_caster>,
        </tn__dd1000000_qD/Geometry/base_link/chassis_link/imu_0_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link"
        {
            over "chassis_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "front_left_wheel_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "front_right_wheel_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "rear_caster" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "imu_0_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "front_bumper_mount" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }

                over "rear_bumper_mount" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }
            }
        }
    }

    over "Physics"
    {
        over "base_link_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_caster_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "imu_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

