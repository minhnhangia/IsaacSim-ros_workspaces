<?xml version="1.0"?>
<!--
  The Nav2 stack for a legged robot in Isaac Sim. Use navigation.launch.py, which fills in the
  robot-specific arguments from params/robot_profiles.yaml; start the simulator first (sim.launch.xml).
  - Costmaps consume the OS0 point cloud directly.
  - The collision monitor (and AMCL, if used) consume a 2D scan flattened from it.
  - TF and odometry come from the simulator; there is no robot_state_publisher.
  - Localization: ground_truth (default) publishes map -> odom as identity, since the simulator's
    odom is the world frame and its odometry is exact; it holds on every floor of the building.
    amcl localizes against the map, which covers one floor only.
-->
<launch>
  <arg name="namespace" description="Robot namespace (the simulator's --namespace, default the robot name)"/>
  <arg name="map" description="Full path to the occupancy-map yaml file"/>
  <arg name="localization" default="ground_truth" description="ground_truth or amcl"/>
  <arg name="params_file" default="$(find-pkg-share isaacsim_legged_nav2)/params/nav2.yaml"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="initial_x" default="0.0" description="AMCL initial pose (map frame); the sim spawns at 0,0,0 by default"/>
  <arg name="initial_y" default="0.0"/>
  <arg name="initial_yaw" default="0.0" description="radians"/>
  <arg name="lidar_name" default="OS0"/>
  <!-- Robot-specific (params/robot_profiles.yaml) -->
  <arg name="footprint" description="Polygon in base_footprint, e.g. '[[0.55, 0.25], [0.55, -0.25], ...]'"/>
  <arg name="scan_range_min" description="Self-filter: horizontal distance from base_footprint (flattened scan, AMCL)"/>
  <arg name="self_filter_range" description="Self-filter: 3D distance from the OS0 (costmap layers)"/>
  <arg name="xy_goal_tolerance"/>
  <arg name="yaw_goal_tolerance"/>
  <arg name="min_approach_velocity" description="Regulated Pure Pursuit speed floor"/>
  <arg name="rotate_to_heading_angular_vel"/>
  <arg name="global_footprint_padding" description="Added to the footprint for planning"/>
  <arg name="local_footprint_padding" description="Added to the footprint for control and collision checks"/>
  <arg name="scan_min_height" default="0.15" description="Scan slice, metres above the floor"/>
  <arg name="scan_max_height" default="1.5"/>
  <arg name="localization_scan_minimum_ranges" default="100"/>

  <!-- Costmaps read the raw cloud best-effort; sim.launch.xml gives the simulator a FastDDS
       profile so whole clouds get through (params/fastdds_large_messages.xml) -->
  <let name="pointcloud_topic" value="/$(var namespace)/$(var lidar_name)/point_cloud"/>
  <let name="collision_scan_topic" value="/$(var namespace)/$(var lidar_name)/scan_from_cloud"/>

  <!-- 3D point cloud -> 2D scan, sliced by height above the floor (base_footprint is on the floor) -->
  <node pkg="pointcloud_to_laserscan" exec="pointcloud_to_laserscan_node"
        name="pointcloud_to_laserscan" namespace="$(var namespace)" output="both">
    <param name="use_sim_time" value="$(var use_sim_time)" type="bool"/>
    <param name="target_frame" value="base_footprint" type="str"/>
    <param name="transform_tolerance" value="0.05"/>
    <param name="min_height" value="$(var scan_min_height)"/>
    <param name="max_height" value="$(var scan_max_height)"/>
    <param name="angle_min" value="-3.14159"/>
    <param name="angle_max" value="3.14159"/>
    <param name="angle_increment" value="0.0087"/>
    <param name="scan_time" value="0.1"/>
    <param name="range_min" value="$(var scan_range_min)"/>
    <param name="range_max" value="50.0"/>
    <param name="use_inf" value="true"/>
    <remap from="/tf" to="tf"/>
    <remap from="/tf_static" to="tf_static"/>
    <remap from="cloud_in" to="$(var pointcloud_topic)"/>
    <remap from="scan" to="$(var lidar_name)/scan_from_cloud"/>
  </node>

  <let name="use_amcl" value="$(eval '&quot;$(var localization)&quot; == &quot;amcl&quot;')"/>

  <node pkg="isaacsim_clearpath_nav2" exec="localization_scan_filter"
        namespace="$(var namespace)" output="both" if="$(var use_amcl)">
    <param name="minimum_valid_ranges" value="$(var localization_scan_minimum_ranges)" type="int"/>
    <remap from="scan" to="$(var lidar_name)/scan_from_cloud"/>
    <remap from="scan_filtered" to="$(var lidar_name)/scan_localization"/>
  </node>

  <include file="$(find-pkg-share nav2_bringup)/launch/rviz_launch.py" if="$(var rviz)">
    <arg name="namespace" value="$(var namespace)"/>
    <arg name="use_namespace" value="true"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <include file="$(find-pkg-share nav2_bringup)/launch/bringup_launch.py">
    <arg name="map" value="$(var map)"/>
    <arg name="namespace" value="$(var namespace)"/>
    <arg name="use_namespace" value="true"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="params_file" value="$(var params_file)"/>
    <arg name="use_localization" value="$(var use_amcl)"/>
  </include>

  <!-- Ground-truth localization: identity map -> odom, and the map server on its own (bringup
       starts it together with AMCL only) -->
  <group unless="$(var use_amcl)">
    <node pkg="tf2_ros" exec="static_transform_publisher" name="map_to_odom" namespace="$(var namespace)"
          args="--frame-id map --child-frame-id odom">
      <remap from="/tf_static" to="tf_static"/>
    </node>
    <node pkg="nav2_map_server" exec="map_server" name="map_server" namespace="$(var namespace)" output="both">
      <param name="use_sim_time" value="$(var use_sim_time)" type="bool"/>
      <param name="yaml_filename" value="$(var map)"/>
    </node>
    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_localization"
          namespace="$(var namespace)" output="both">
      <param name="use_sim_time" value="$(var use_sim_time)" type="bool"/>
      <param name="autostart" value="true"/>
      <param name="node_names" value="[map_server]"/>
    </node>
  </group>
</launch>
